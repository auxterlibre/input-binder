@tool

const Store := preload("res://addons/input_binder/input_store.gd")

const GENERATE_SETTING := "addons/input_binder/generate_constants"
const OUTPUT_PATH := "res://input_binder/input_actions.gd"
const GENERATED_CLASS := "InputBinder"


static func enabled() -> bool:
	return bool(ProjectSettings.get_setting(GENERATE_SETTING, false))


static func set_enabled(on: bool) -> void:
	ProjectSettings.set_setting(GENERATE_SETTING, true if on else null)
	ProjectSettings.save()


static func conflict_reason() -> String:
	for global_class in ProjectSettings.get_global_class_list():
		if String(global_class["class"]) == GENERATED_CLASS and String(global_class.path) != OUTPUT_PATH:
			return "class_name %s is already taken by %s." % [GENERATED_CLASS, global_class.path]
	if ProjectSettings.has_setting("autoload/" + GENERATED_CLASS):
		return "an autoload named %s exists." % GENERATED_CLASS
	return ""


static func const_identifier(action: String, used: Dictionary) -> String:
	var out := ""
	for ch in action.to_upper():
		var keep := (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9")
		out += ch if keep else "_"
	while out.contains("__"):
		out = out.replace("__", "_")
	out = out.lstrip("_").rstrip("_")
	if out.is_empty():
		out = "A_%d" % absi(action.hash())
	elif out[0] >= "0" and out[0] <= "9":
		out = "A_" + out
	var candidate := out
	var n := 2
	while used.has(candidate):
		candidate = "%s_%d" % [out, n]
		n += 1
	used[candidate] = true
	return candidate


static func build_source(layout: Dictionary, actions: PackedStringArray) -> String:
	var customs := PackedStringArray()
	for action in actions:
		if not Store.is_builtin(action):
			customs.append(action)
	var groups := []
	for category in layout.categories:
		var members := PackedStringArray()
		for action in category.actions:
			if action in customs:
				members.append(action)
		if not members.is_empty():
			groups.append({"name": category.name, "actions": members})
	var uncategorized := PackedStringArray()
	for action in customs:
		if Store.category_of(layout, action).is_empty():
			uncategorized.append(action)
	if not uncategorized.is_empty():
		groups.append({"name": "Uncategorized", "actions": uncategorized})

	var used := {}
	var all_identifiers := PackedStringArray()
	var lines := PackedStringArray()
	lines.append("class_name " + GENERATED_CLASS)
	lines.append("## Generated by Input Binder. Regenerated automatically - manual edits will be lost.")
	for group in groups:
		lines.append("")
		lines.append("# " + group.name)
		for action in group.actions:
			var identifier := const_identifier(action, used)
			all_identifiers.append(identifier)
			lines.append("const %s := &\"%s\"" % [identifier, action])
	lines.append("")
	lines.append("const ALL: Array[StringName] = [%s]" % ", ".join(all_identifiers))
	lines.append("")
	return "\n".join(lines)


static func regenerate() -> void:
	if not enabled():
		return
	var conflict := conflict_reason()
	if not conflict.is_empty():
		push_warning("Input Binder: constants file not generated - " + conflict)
		return
	var source := build_source(Store.get_layout(), Store.list_actions())
	if FileAccess.file_exists(OUTPUT_PATH) and FileAccess.get_file_as_string(OUTPUT_PATH) == source:
		return
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUTPUT_PATH.get_base_dir()))
	var file := FileAccess.open(OUTPUT_PATH, FileAccess.WRITE)
	if file == null:
		push_warning("Input Binder: cannot write " + OUTPUT_PATH)
		return
	file.store_string(source)
	file.close()
	if Engine.is_editor_hint():
		EditorInterface.get_resource_filesystem().scan()
